# Local APK and release staging. Release uploads are GitHub assets, not repo content.
/artifacts/

# Collector runtime output may contain account or device state.
/collector/data/*
!/collector/data/.gitkeep

# Local publish scratch
/publish*

# Migration preservation and private inputs: never publish.
/local/
/var/
/.env
__pycache__/
*.pyc
*.jks
*.keystore


# Runtime logs are private and regenerated.
*.log
/logs/
